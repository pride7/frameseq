{
  "FrameSeq presentation": {
    "prefix": "frameseq-presentation",
    "description": "Create a FrameSeq presentation and cover slide",
    "body": [
      "presentation({ title: \"${1:My presentation}\", theme: \"${2:minimal-academic}\" });",
      "",
      "slide({ name: \"Cover\" }).cover();",
      "text(\"${1:My presentation}\").hero();",
      "text(\"${3:A concise subtitle}\").subtitle();",
      "text(\"${4:Your name}\").author();"
    ]
  },
  "FrameSeq slide": {
    "prefix": "slide",
    "description": "Insert a FrameSeq slide",
    "body": [
      "slide(\"${1:Slide title}\");",
      "text(\"${2:Start with one clear idea.}\");"
    ]
  },
  "FrameSeq split slide": {
    "prefix": "slide-split",
    "description": "Insert a two-column FrameSeq slide",
    "body": [
      "slide(\"${1:Slide title}\").split(\"${2:40:60}\");",
      "text(\"${3:Left column}\");",
      "",
      "right();",
      "text(\"${4:Right column}\");"
    ]
  },
  "FrameSeq grid slide": {
    "prefix": "slide-grid",
    "description": "Insert a FrameSeq grid slide",
    "body": [
      "slide(\"${1:Slide title}\").grid(${2:3});",
      "",
      "cell(0);",
      "text(\"${3:First cell}\");",
      "cell(1);",
      "text(\"${4:Second cell}\");",
      "cell(2);",
      "text(\"${5:Third cell}\");"
    ]
  },
  "FrameSeq local grid section": {
    "prefix": "grid-section",
    "description": "Insert a local FrameSeq grid in the normal slide flow",
    "body": [
      "gridSection(",
      "  ${1:3},",
      "  card(\"${2:First title}\", \"${3:First description}\"),",
      "  card(\"${4:Second title}\", \"${5:Second description}\"),",
      "  card(\"${6:Third title}\", \"${7:Third description}\"),",
      ").gap(${8:20});"
    ]
  },
  "FrameSeq canvas slide": {
    "prefix": "slide-canvas",
    "description": "Insert an absolute-positioned FrameSeq canvas slide",
    "body": [
      "slide(\"${1:Slide title}\").canvas();",
      "text(\"${2:Positioned object}\")",
      "  .position({ x: ${3:80}, y: ${4:120} })",
      "  .width(${5:420});"
    ]
  },
  "FrameSeq diagram": {
    "prefix": "diagram",
    "description": "Insert a FrameSeq diagram whose objects are named and connected",
    "body": [
      "slide(\"${1:Slide title}\").canvas();",
      "",
      "rect(\"${2:First stage}\").as(\"${3:first}\")",
      "  .position({ x: ${4:120}, y: ${5:160} })",
      "  .width(${6:220})",
      "  .height(${7:110});",
      "rect(\"${8:Second stage}\").as(\"${9:second}\").rightOf(\"${3:first}\", ${10:140});",
      "",
      "line().from(\"${3:first}\").to(\"${9:second}\").arrow(\"end\");"
    ]
  },
  "FrameSeq region path": {
    "prefix": "at",
    "description": "Insert a named FrameSeq region and its content",
    "body": [
      "at(\"${1:notes/detail}\").card();",
      "text(\"${2:Eyebrow}\").eyebrow();",
      "text(\"${3:Supporting copy}\");"
    ]
  },
  "FrameSeq bullets": {
    "prefix": "bullets",
    "description": "Insert FrameSeq bullet points",
    "body": [
      "bullets(",
      "  \"${1:First point}\",",
      "  \"${2:Second point}\",",
      "  \"${3:Third point}\",",
      ");"
    ]
  },
  "FrameSeq speaker note": {
    "prefix": "note",
    "description": "Add speaker notes to the current slide",
    "body": [
      "note(\"${1:What to say here.}\");"
    ]
  },
  "FrameSeq LaTeX": {
    "prefix": "latex",
    "description": "Insert a compiled LaTeX fragment",
    "body": [
      "latex`",
      "  ${1:\\\\begin{tabular}{lr}}",
      "  ${2:Label & Value \\\\\\\\}",
      "  ${3:\\\\end{tabular}}",
      "`;"
    ]
  },
  "FrameSeq Typst": {
    "prefix": "typst",
    "description": "Insert a compiled Typst fragment",
    "body": [
      "typst`",
      "  ${1:$ integral_0^1 x^2 dif x = 1/3 $}",
      "`;"
    ]
  }
}
